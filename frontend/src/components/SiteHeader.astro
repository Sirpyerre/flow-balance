---
const { mode = 'landing' } = Astro.props;
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Flow Balance, inicio"><span aria-hidden="true">FB</span> Flow Balance</a>
  <nav aria-label="Navegación principal">
    {mode === 'landing' && <><a class="section-link" href="/#funciones">Funciones</a><a class="section-link" href="/#privacidad">Privacidad</a></>}
    {mode !== 'login' && <a class="button" href="/login">Iniciar sesión</a>}
    {mode !== 'register' && <a class="button primary" href="/register">Crear cuenta</a>}
  </nav>
</header>
<style>
  .site-header { max-width: 1200px; margin: auto; min-height: 90px; padding: 24px 40px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--border); }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--text); text-decoration: none; font-size: 20px; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; }
  .brand span { display: grid; place-items: center; width: 36px; height: 36px; flex: 0 0 36px; border: 2px solid currentColor; border-radius: 50%; font-size: 14px; letter-spacing: 0; }
  nav { display: flex; align-items: center; gap: 16px; }
  .section-link { color: var(--label); text-decoration: none; font-size: 14px; }
  .section-link:hover { color: var(--link); }
  @media (max-width: 740px) { .site-header { padding: 16px 24px; min-height: 72px; flex-wrap: wrap; } nav { gap: 8px; } .section-link { display: none; } }
  @media (max-width: 460px) { .brand { font-size: 15px; gap: 8px; } nav .button { font-size: 13px; padding: 8px 10px; } }
</style>
