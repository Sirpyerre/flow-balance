# Se copia a /var/www/flowbalance/shared/.env (modo 600, dueño flowbalance) y se completa EN EL SERVIDOR.
# No contiene valores reales y no se sube nunca desde GitHub: los secretos de la aplicación viven solo allí.

APP_ENV=production

# Origen público, con HTTPS, sin barra final ni ruta, en minúsculas. Si es inválido, toda la API responde 503.
APP_ORIGIN=https://flow.monoforms.com

# Al menos 32 caracteres; con menos, el inicio de sesión responde 503. Genérelo con:  openssl rand -hex 32
APP_SECRET=

# MariaDB escucha solo en 127.0.0.1; el usuario solo tiene privilegios sobre la base de Flow Balance.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flow_balance
DB_USERNAME=flow_balance_app
DB_PASSWORD=

# No definir TRUSTED_API_PROXY_PEERS ni CLIENT_IP_PROXY_TOKEN: Nginx ya entrega la IP real del visitante
# (real_ip_header CF-Connecting-IP) en REMOTE_ADDR.
