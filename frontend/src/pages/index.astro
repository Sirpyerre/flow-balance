---
import AppLayout from '../layouts/AppLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const description = 'Flow Balance ayuda a profesionales freelance a organizar sus clientes, proyectos y cobros, y a consultar cuánto les han pagado cada mes.';
const features = [
  { icon: '♧', color: '#a78bfa', title: 'Clientes y proyectos en un solo lugar', text: 'Consulta tus registros y los cobros vinculados a cada proyecto.' },
  { icon: '▥', color: '#fb7185', title: 'Resumen mensual de cobros', text: 'Consulta cuánto te abonaron tus clientes y qué cobros componen el total.' },
  { icon: '▣', color: '#60a5fa', title: 'Datos privados por cuenta', text: 'Cada persona accede únicamente a sus clientes, proyectos, cobros y reportes.' },
  { icon: '◎', color: '#34d399', title: 'Acceso desde el navegador', text: 'Entra con tu correo y contraseña para recuperar tus datos desde otro dispositivo.' },
];
---
<AppLayout description={description} publicPage>
  <SiteHeader slot="header" />
  <div class="landing">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow">Finanzas para freelancers</p>
      <h1 id="hero-title">Sabe cuánto te pagaron<br class="desktop-break" /> cada mes.</h1>
      <p>{description}</p>
      <div class="actions">
        <a class="button primary large" href="/register">Crear cuenta</a>
        <a class="button large" href="/login">Iniciar sesión</a>
      </div>
    </section>

    <section class="intro" data-reveal>
      <h2>Empieza a organizar tus cobros.</h2>
      <a class="button primary" href="/register">Crear cuenta <span aria-hidden="true">→</span></a>
    </section>

    <section id="funciones" class="features" aria-labelledby="features-title" data-reveal>
      <span class="pill">Lo que puedes hacer</span>
      <h2 id="features-title">Todo tu trabajo financiero, ordenado.</h2>
      <div class="feature-grid">
        {features.map(({ icon, color, title, text }) => (
          <article class="feature-card">
            <span class="feature-icon" style={{color}} aria-hidden="true">{icon}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="split" aria-labelledby="payments-title" data-reveal>
      <figure class="preview">
        <figcaption>Ejemplo de reporte mensual</figcaption>
        <div class="preview-content">
          <p>Importe abonado</p>
          <strong>MXN 3,000.00</strong>
          <ul><li><span>Identidad visual</span><span>MXN 2,000.00</span></li><li><span>Sitio web</span><span>MXN 1,000.00</span></li></ul>
        </div>
      </figure>
      <div class="split-copy">
        <h2 id="payments-title">Cada cobro, ligado a su proyecto.</h2>
        <p>Consulta tus clientes, proyectos y cobros relacionados sin buscar en hojas separadas.</p>
        <ul class="checks"><li>Clientes con sus proyectos</li><li>Cobros vinculados a cada proyecto</li><li>Resumen mensual de cobros</li></ul>
        <a class="button primary" href="/register">Crear cuenta</a>
      </div>
    </section>

    <section id="privacidad" class="split privacy" aria-labelledby="privacy-title" data-reveal>
      <div class="split-copy">
        <h2 id="privacy-title">Tus datos, solo tuyos.</h2>
        <p>Cada cuenta tiene sus propios clientes, proyectos, cobros y reportes. Entra desde tu navegador con tu correo y contraseña.</p>
        <ul class="checks"><li>Datos privados por cuenta</li><li>Recupera tus datos desde otro dispositivo</li><li>Interfaz en español de México</li></ul>
        <a class="button" href="/login">Iniciar sesión</a>
      </div>
      <figure class="preview">
        <figcaption>Ejemplo de vista de cuenta</figcaption>
        <div class="preview-content">
          <p>Tu tablero</p>
          <strong>Tu actividad</strong>
          <ul><li><span>Clientes</span><span>2</span></li><li><span>Proyectos</span><span>2</span></li><li><span>Cobros</span><span>2</span></li></ul>
        </div>
      </figure>
    </section>

    <section class="closing" aria-labelledby="closing-title" data-reveal>
      <h2 id="closing-title">Empieza a organizar tus cobros.</h2>
      <p>Tus clientes, proyectos y cobros, disponibles desde tu navegador.</p>
      <div class="actions">
        <a class="button primary large" href="/register">Crear cuenta</a>
        <a class="button large" href="/login">Iniciar sesión</a>
      </div>
    </section>
  </div>
  <footer slot="footer" class="site-footer">
    <div class="footer-links">
      <div><a class="footer-brand" href="/">Flow Balance</a><p>{description}</p></div>
      <nav aria-label="Producto"><strong>Producto</strong><a href="#funciones">Funciones</a><a href="#privacidad">Privacidad</a></nav>
      <nav aria-label="Cuenta"><strong>Cuenta</strong><a href="/register">Crear cuenta</a><a href="/login">Iniciar sesión</a></nav>
    </div>
    <p class="copyright">© {new Date().getFullYear()} Flow Balance</p>
  </footer>
</AppLayout>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('revealed');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.12 });
    document.querySelectorAll('[data-reveal]').forEach((section) => observer.observe(section));
  }
</script>

<style>
  .landing { width: min(1120px, calc(100% - 48px)); margin: auto; }
  .hero { padding-top: clamp(66px, 7vw, 92px); padding-bottom: 64px; }
  .eyebrow { color: var(--label); text-transform: uppercase; font-weight: 600; font-size: 13px; letter-spacing: .14em; display: flex; align-items: center; gap: 14px; margin: 0 0 20px; }
  .eyebrow::after { content: ''; width: 64px; height: 2px; background: var(--gradient); }
  h1, h2, h3 { margin: 0; }
  h1 { max-width: 850px; font-size: clamp(42px, 5.1vw, 64px); letter-spacing: -.045em; line-height: 1.05; }
  h2 { font-size: clamp(28px, 3.5vw, 44px); letter-spacing: -.035em; line-height: 1.12; }
  .hero > p:not(.eyebrow) { color: var(--muted); max-width: 540px; margin: 28px 0 36px; font-size: 18px; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .large { min-height: 54px; padding-inline: 28px; text-transform: uppercase; }
  .intro { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 22px; align-items: center; padding: 40px 0 48px; border-bottom: 1px solid var(--border); }
  .intro h2 { font-size: clamp(24px, 3vw, 33px); }
  section[id] { scroll-margin-top: 28px; }
  .features { padding-top: clamp(72px, 9vw, 120px); text-align: center; }
  .pill { display: inline-block; color: var(--link); background: rgb(139 92 246 / .12); padding: 8px 14px; border-radius: 8px; font-size: 14px; margin-bottom: 26px; }
  .feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 56px; text-align: left; }
  .feature-card, .preview { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; }
  .feature-card { padding: 26px; }
  .feature-icon { display: block; font-size: 30px; margin-bottom: 24px; }
  .feature-card h3 { font-size: 20px; line-height: 1.2; }
  .feature-card p, .split p, .closing p, .footer-links p { color: var(--muted); }
  .feature-card p { font-size: 15px; margin: 12px 0 6px; }
  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 62px; margin-top: clamp(64px, 8vw, 104px); }
  .split-copy > p { margin: 18px 0 24px; font-size: 17px; }
  .checks, .preview ul { padding: 0; list-style: none; }
  .checks { display: grid; gap: 12px; margin-bottom: 22px; }
  .checks li { display: flex; gap: 10px; align-items: center; }
  .checks li::before { content: '✓'; display: grid; flex: 0 0 22px; height: 22px; place-items: center; border-radius: 50%; background: var(--gradient); font-size: 12px; font-weight: 700; }
  .preview { margin: 0; min-height: 400px; padding: clamp(18px, 4vw, 52px); display: grid; align-content: center; gap: 16px; background: linear-gradient(155deg, var(--highlight-surface), var(--surface)); }
  figcaption { color: var(--muted); font-size: 14px; }
  .preview-content { padding: clamp(16px, 3vw, 28px); border: 1px solid var(--border); background: var(--base); border-radius: 14px; }
  .preview-content p { margin: 0 0 5px; font-size: 14px; }
  .preview-content strong { font-size: clamp(20px, 3vw, 32px); }
  .preview ul { margin: 20px 0 0; }
  .preview li { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px 16px; padding: 12px 0; border-top: 1px solid var(--border); font-size: 14px; }
  .closing { margin: clamp(64px, 8vw, 104px) 0; padding: 72px 24px; background: linear-gradient(105deg, var(--highlight-surface), var(--highlight-end)); border-radius: 24px; text-align: center; }
  .closing .actions { justify-content: center; margin-top: 28px; }
  .site-footer { max-width: 1200px; margin: auto; border-top: 1px solid var(--border); }
  .footer-links { display: grid; grid-template-columns: 2fr 1fr 1fr; padding: 54px 40px 36px; gap: 22px; font-size: 14px; }
  .footer-links p { max-width: 390px; }
  .footer-links a { color: var(--muted); text-decoration: none; }
  .footer-links a:hover { color: var(--link); }
  .footer-links .footer-brand { font-weight: 700; color: var(--text); text-transform: uppercase; }
  .footer-links nav { display: grid; align-content: start; gap: 10px; }
  .copyright { color: var(--muted); font-size: 13px; border-top: 1px solid var(--border); margin: 0; padding: 22px 40px; }
  @media (prefers-reduced-motion: no-preference) {
    .revealed { animation: section-enter .55s ease-out both; }
    @keyframes section-enter { from { opacity: .45; transform: translateY(20px); } }
  }
  @media (max-width: 900px) { .feature-grid { grid-template-columns: repeat(2, 1fr); } .split { gap: 30px; } .preview { min-height: 300px; } }
  @media (max-width: 620px) { .desktop-break { display: none; } .split, .feature-grid { grid-template-columns: 1fr; } .split-copy { grid-row: 1; } .feature-grid { margin-top: 32px; } .large { min-height: 48px; padding-inline: 16px; } .footer-links { grid-template-columns: repeat(2, 1fr); padding-inline: 24px; } .footer-links > div { grid-column: 1 / -1; } .copyright { padding-inline: 24px; } }
</style>
